n trying to keep a BFS in the right order.\n\n`O(n log n)` time, `O(n)` space.","code":{"python":"def verticalTraversal(root):\n    triples = []\n\n    def walk(node, row, column):\n        if node is None:\n            return\n        triples.append((column, row, node.val))\n        walk(node.left, row + 1, column - 1)\n        walk(node.right, row + 1, column + 1)\n\n    walk(root, 0, 0)\n    triples.sort()\n    out = []\n    last_column = None\n    for column, _, value in triples:\n        if column != last_column:\n            out.append([])\n            last_column = column\n        out[-1].append(value)\n    return out\n"},"complexity":"O(n log n) time, O(n) space"}}
