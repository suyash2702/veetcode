n    if root is None:\n        return []\n    seen = {}\n    queue = [(root, 0)]\n    head = 0\n    while head < len(queue):\n        node, column = queue[head]\n        head += 1\n        seen[column] = node.val\n        if node.left:\n            queue.append((node.left, column - 1))\n        if node.right:\n            queue.append((node.right, column + 1))\n    return [seen[c] for c in sorted(seen)]\n"},"complexity":"O(n) time, O(n) space"}}
