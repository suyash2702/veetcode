__gen__":"string","n":250,"alphabet":"abcd","seed":6764}],"output":130},{"input":[{"__gen__":"string","n":400,"alphabet":"abcd","seed":6725},{"__gen__":"string","n":380,"alphabet":"abcd","seed":6765}],"output":213},{"input":[{"__gen__":"string","n":500,"alphabet":"abcd","seed":6726},{"__gen__":"string","n":450,"alphabet":"abcd","seed":6766}],"output":257}],"hints":["dp[i][j] is the distance between the first i characters of word1 and the first j of word2.","Equal characters cost nothing; otherwise pay 1 plus the best of insert, delete or replace."],"complexity":"O(m * n) time","starter":{"python":"def minDistance(word1, word2):\n    # TODO: implement\n    pass\n","javascript":"/**\n * @param {*} word1\n * @param {*} word2\n * @return {*}\n */\nvar minDistance = function (word1, word2) {\n  // TODO: implement\n};\n"},"editorial":{"explanation":"Classic two-dimensional DP. `dp[i][j]` is the distance between the first `i` characters of one word\nand the first `j` of the other.\n\nEqual characters cost nothing and inherit the diagonal. Otherwise the cost is one plus the best of\nthe three edits: replace (diagonal), delete (up), insert (left). The first row and column are just\n\"delete everything so far\".\n\n`O(m * n)` time; keeping only the previous row drops space to `O(min(m, n))`.","code":{"python":"def minDistance(word1, word2):\n    m, n = len(word1), len(word2)\n    prev = list(range(n + 1))\n    for i in range(1, m + 1):\n        cur = [i] + [0] * n\n        for j in range(1, n + 1):\n            if word1[i - 1] == word2[j - 1]:\n                cur[j] = prev[j - 1]\n            else:\n                cur[j] = 1 + min(prev[j], cur[j - 1], prev[j - 1])\n        prev = cur\n    return prev[n]\n"},"complexity":"O(m * n) time"}}
