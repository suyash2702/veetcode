ums, target):\n    reachable = [False] * (target + 1)\n    reachable[0] = True\n    for value in nums:\n        if value == 0:\n            continue\n        for total in range(target, value - 1, -1):\n            if reachable[total - value]:\n                reachable[total] = True\n    return reachable[target]\n"},"complexity":"O(n * target) time, O(target) space"}}
