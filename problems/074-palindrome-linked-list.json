],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"arange","n":2,"start":0,"step":1},[9],{"__gen__":"arange","n":2,"start":1,"step":-1}]}],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"arange","n":5,"start":0,"step":1},{"__gen__":"arange","n":5,"start":4,"step":-1}]}],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"arange","n":5,"start":0,"step":1},[9],{"__gen__":"arange","n":5,"start":4,"step":-1}]}],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"arange","n":50,"start":0,"step":1},{"__gen__":"arange","n":50,"start":49,"step":-1}]}],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"arange","n":50,"start":0,"step":1},[9],{"__gen__":"arange","n":50,"start":49,"step":-1}]}],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"arange","n":5000,"start":0,"step":1},{"__gen__":"arange","n":5000,"start":4999,"step":-1}]}],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"arange","n":5000,"start":0,"step":1},[9],{"__gen__":"arange","n":5000,"start":4999,"step":-1}]}],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"arange","n":50000,"start":0,"step":1},{"__gen__":"arange","n":50000,"start":49999,"step":-1}]}],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"arange","n":50000,"start":0,"step":1},[9],{"__gen__":"arange","n":50000,"start":49999,"step":-1}]}],"output":true},{"input":[{"__gen__":"repeat","value":7,"n":100000}],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"repeat","value":7,"n":99999},[8]]}],"output":false},{"input":[[1,1]],"output":true},{"input":[[1,2,3]],"output":false}],"hints":["Copying to an array is O(n) space; the constant-space version reverses the second half.","Find the middle with slow/fast pointers, reverse from there, then compare the halves."],"paramTypes":["list"],"complexity":"O(n) time, O(1) space","starter":{"python":"# head is a ListNode built for you; the class is already defined.\ndef isPalindrome(head):\n    # TODO: implement\n    pass\n","javascript":"/**\n * @param {ListNode} head\n * @return {*}\n */\nvar isPalindrome = function (head) {\n  // TODO: implement\n};\n"},"editorial":{"explanation":"Copying values into an array makes this trivial in `O(n)` space. The constant-space version does\nthree things: find the middle with slow/fast pointers, reverse the second half in place, then walk\nthe two halves in lockstep.\n\nCompare until the reversed half runs out — with an odd length the middle node belongs to both halves\nand never needs checking.\n\n`O(n)` time, `O(1)` space. Politeness suggests restoring the list afterwards.","code":{"python":"def isPalindrome(head):\n    slow = fast = head\n    while fast and fast.next:\n        slow = slow.next\n        fast = fast.next.next\n\n    prev = None\n    while slow:\n        slow.next, prev, slow = prev, slow, slow.next\n\n    left, right = head, prev\n    while right:\n        if left.val != right.val:\n            return False\n        left = left.next\n        right = right.next\n    return True\n"},"complexity":"O(n) time, O(1) space"}}
