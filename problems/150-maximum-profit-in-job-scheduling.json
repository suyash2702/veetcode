{"id":150,"slug":"maximum-profit-in-job-scheduling","title":"Maximum Profit in Job Scheduling","difficulty":"Hard","tags":["Array","Dynamic Programming","Binary Search","Sorting"],"description":"Jobs may not overlap, though one may start exactly when another ends. Return the largest profit obtainable.\n\n**Constraints**\n\n- `1 <= n <= 5 * 10^4`\n- `1 <= startTime[i] < endTime[i] <= 10^9`\n- `1 <= profit[i] <= 10^4`","functionName":"jobScheduling","params":["startTime","endTime","profit"],"tests":[{"input":[[1,2,3,3],[3,4,5,6],[50,10,40,70]],"output":120,"sample":true},{"input":[[1,2,3,4,6],[3,5,10,6,9],[20,20,100,70,60]],"output":150,"sample":true},{"input":[[1,1,1],[2,3,4],[5,6,4]],"output":6},{"input":[[1],[2],[5]],"output":5},{"input":[{"__gen__":"ints","n":1,"lo":1,"hi":999999000,"seed":21300},{"__gen__":"zipsum","parts":[{"__gen__":"ints","n":1,"lo":1,"hi":999999000,"seed":21300},{"__gen__":"ints","n":1,"lo":1,"hi":1000,"seed":21350}]},{"__gen__":"ints","n":1,"lo":1,"hi":10000,"seed":21400}],"output":6698},{"input":[{"__gen__":"ints","n":2,"lo":1,"hi":999999000,"seed":21301},{"__gen__":"zipsum","parts":[{"__gen__":"ints","n":2,"lo":1,"hi":999999000,"seed":21301},{"__gen__":"ints","n":2,"lo":1,"hi":1000,"seed":21351}]},{"__gen__":"ints","n":2,"lo":1,"hi":10000,"seed":21401}],"output":10265},{"input":[{"__gen__":"ints","n":3,"lo":1,"hi":999999000,"seed":21302},{"__gen__":"zipsum","parts":[{"__gen__":"ints","n":3,"lo":1,"hi":999999000,"seed":21302},{"__gen__":"ints","n":3,"lo":1,"hi":1000,"seed":21352}]},{"__gen__":"ints","n":3,"lo":1,"hi":10000,"seed":21402}],"output":21122},{"input":[{"__gen__":"ints","n":8,"lo":1,"hi":999999000,"seed":21303},{"__gen__":"zipsum","parts":[{"__gen__":"ints","n":8,"lo":1,"hi":999999000,"seed":21303},{"__gen__":"ints","n":8,"lo":1,"hi":1000,"seed":21353}]},{"__gen__":"ints","n":8,"lo":1,"hi":10000,"seed":21403}],"output":36310},{"input":[{"__gen__":"ints","n":40,"lo":1,"hi":999999000,"seed":21304},{"__gen__":"zipsum","parts":[{"__g