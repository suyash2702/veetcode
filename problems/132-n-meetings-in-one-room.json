    # TODO: implement\n    pass\n","javascript":"/**\n * @param {*} start\n * @param {*} end\n * @return {*}\n */\nvar maxMeetings = function (start, end) {\n  // TODO: implement\n};\n"},"editorial":{"explanation":"Classic activity selection: sort by finishing time and take every meeting that starts after the last\none ended.\n\nFinishing earliest leaves the most room for everything after it — sorting by start time or by\nduration both produce counterexamples.\n\n`O(n log n)` time, `O(n)` space for the sort.","code":{"python":"def maxMeetings(start, end):\n    meetings = sorted(zip(end, start))\n    count, last_end = 0, float(\"-inf\")\n    for finish, begin in meetings:\n        if begin > last_end:\n            count += 1\n            last_end = finish\n    return count\n"},"complexity":"O(n log n) time, O(n) space"}}
