a","a","a","c","a","d"],["a","d","c","d","b","d","b","c","d","c","d","b"]],"addbdcdcabbbdbbccccb"],"output":true},{"input":[[["a","d","c","d","a","d"],["c","b","a","a","b","a"],["b","c","d","b","b","a"],["a","a","c","b","b","d"],["c","d","c","a","c","d"],["d","a","a","d","c","a"]],"dbabadcdac"],"output":true},{"input":[[["a","d","c","d","a","d"],["c","b","a","a","b","a"],["b","c","d","b","b","a"],["a","a","c","b","b","d"],["c","d","c","a","c","d"],["d","a","a","d","c","a"]],"dbabadcdacz"],"output":false},{"input":[[["a","a","a","b"],["b","b","b","b"],["a","b","a","a"],["a","b","a","a"]],"abababababab"],"output":false},{"input":[[["a","a","a","b"],["b","b","b","b"],["a","b","a","a"],["a","b","a","a"]],"aaaaac"],"output":false},{"input":[[["b","a","b","a","a","a","a","b"],["b","a","b","b","b","b","b","b"],["a","b","b","a","b","a","a","a"],["a","b","b","b","a","b","b","b"],["b","a","a","b","b","b","a","b"],["a","b","b","a","b","a","b","b"],["a","b","b","a","a","a","a","b"],["b","b","b","b","b","a","b","b"]],"abababababab"],"output":true},{"input":[[["b","a","b","a","a","a","a","b"],["b","a","b","b","b","b","b","b"],["a","b","b","a","b","a","a","a"],["a","b","b","b","a","b","b","b"],["b","a","a","b","b","b","a","b"],["a","b","b","a","b","a","b","b"],["a","b","b","a","a","a","a","b"],["b","b","b","b","b","a","b","b"]],"aaaaac"],"output":false},{"input":[[["a","a","a","b","b","a","a","a","b","b","b","b"],["a","b","b","b","b","a","a","a","a","a","a","b"],["a","a","b","b","b","b","b","b","a","a","b","b"],["a","b","b","b","a","b","a","b","a","b","b","a"],["a","a","a","b","b","b","a","a","b","b","a","a"],["b","a","a","a","b","b","a","a","a","a","b","b"],["a","b","a","b","a","b","a","a","a","a","a","a"],["a","b","b","a","b","b","a","b","b","b","a","a"],["a","a","b","a","a","a","b","a","b","b","a","a"],["a","a","b","a","a","a","b","b","a","b","a","b"],["a","b","a","a","a","a","a","a","b","a","a","b"],["b","a","b","a","b","a","b","b","a","a","b","a"]],"abababababab"],"output":true},{"input":[[["a","a","a","b","b","a","a","a","b","b","b","b"],["a","b","b","b","b","a","a","a","a","a","a","b"],["a","a","b","b","b","b","b","b","a","a","b","b"],["a","b","b","b","a","b","a","b","a","b","b","a"],["a","a","a","b","b","b","a","a","b","b","a","a"],["b","a","a","a","b","b","a","a","a","a","b","b"],["a","b","a","b","a","b","a","a","a","a","a","a"],["a","b","b","a","b","b","a","b","b","b","a","a"],["a","a","b","a","a","a","b","a","b","b","a","a"],["a","a","b","a","a","a","b","b","a","b","a","b"],["a","b","a","a","a","a","a","a","b","a","a","b"],["b","a","b","a","b","a","b","b","a","a","b","a"]],"aaaaac"],"output":false},{"input":[[["a","b","a","a","a","a"],["b","a","b","a","b","a"],["a","a","b","b","b","a"],["b","a","a","b","b","b"],["a","b","b","a","b","a"],["b","a","a","a","a","b"]],"abababababab"],"output":true},{"input":[[["a","b","a","a","a","a"],["b","a","b","a","b","a"],["a","a","b","b","b","a"],["b","a","a","b","b","b"],["a","b","b","a","b","a"],["b","a","a","a","a","b"]],"aaaaac"],"output":false},{"input":[[["a","a","a","a","a","a"],["a","a","a","a","a","a"],["a","a","a","a","a","a"],["a","a","a","a","a","a"],["a","a","a","a","a","a"],["a","a","a","a","a","a"]],"aaaaaaaaaaab"],"output":false},{"input":[[["a","a","a","a"],["a","a","a","a"],["a","a","a","a"],["a","a","a","a"]],"aaaaaaaa"],"output":true},{"input":[[["a"]],"b"],"output":false},{"input":[[["a","b"]],"ba"],"output":true},{"input":[[["a"],["b"]],"ab"],"output":true}],"hints":["Backtrack from every cell; mark a cell as used before recursing and restore it afterwards."],"complexity":"O(m * n * 4^L) time","starter":{"python":"def exist(board, word):\n    # TODO: implement\n    pass\n","javascript":"/**\n * @param {*} board\n * @param {*} word\n * @return {*}\n */\nvar exist = function (board, word) {\n  // TODO: implement\n};\n"},"editorial":{"explanation":"Depth-first search from every cell, matching one character per step and marking the current cell as\nused so a path cannot reuse it.\n\nThe mark must be undone on the way back out, otherwise later paths see cells as blocked. Writing a\nsentinel like `'#'` into the board and restoring it afterwards avoids a separate visited set.\n\nWorst case `O(m * n * 4^L)`; the early exit on a character mismatch is what keeps it fast in\npractice.","code":{"python":"def exist(board, word):\n    rows, cols = len(board), len(board[0])\n\n    def dfs(r, c, i):\n        if i == len(word):\n            return True\n        if r < 0 or c < 0 or r >= rows or c >= cols or board[r][c] != word[i]:\n            return False\n        board[r][c] = '#'\n        found = (dfs(r + 1, c, i + 1) or dfs(r - 1, c, i + 1)\n                 or dfs(r, c + 1, i + 1) or dfs(r, c - 1, i + 1))\n        board[r][c] = word[i]\n        return found\n\n    return any(dfs(r, c, 0) for r in range(rows) for c in range(cols))\n"},"complexity":"O(m * n * 4^L) time"}}
