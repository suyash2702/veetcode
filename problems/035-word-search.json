{"id":35,"slug":"word-search","title":"Word Search","difficulty":"Medium","tags":["Matrix","Backtracking","DFS"],"description":"Given an `m x n` grid of characters and a `word`, return `true` if the word can be spelled by walking through horizontally or vertically neighbouring cells.\n\nThe same cell may not be used twice in one path.\n\n**Constraints**\n\n- `1 <= m, n <= 12`\n- `1 <= word.length <= 20`","functionName":"exist","params":["board","word"],"tests":[{"input":[[["A","B","C","E"],["S","F","C","S"],["A","D","E","E"]],"ABCCED"],"output":true,"sample":true},{"input":[[["A","B","C","E"],["S","F","C","S"],["A","D","E","E"]],"ABCB"],"output":false,"sample":true,"explanation":"The B cell cannot be reused."},{"input":[[["A","B","C","E"],["S","F","C","S"],["A","D","E","E"]],"SEE"],"output":true},{"input":[[["a"]],"a"],"output":true},{"input":[[["a","b"],["c","d"]],"abcd"],"output":false},{"input":[[["a"]],"az"],"output":false},{"input":[[["a","d","c","d","b","c"]],"adc"],"output":true},{"input":[[["a","d","c","d","b","c"]],"adcz"],"output":false},{"input":[[["c"],["b"],["c"],["d"],["a"],["c"]],"cbc"],"output":true},{"input":[[["c"],["b"],["c"],["d"],["a"],["c"]],"cbcz"],"output":false},{"input":[[["d","a","a"],["b","c","d"],["c","c","b"]],"caadz"],"output":false},{"input":[[["c","b","a","b"],["c","d","b","c"],["c","a","b","d"],["d","c","b","c"]],"cbabcc"],"output":true},{"input":[[["c","b","a","b"],["c","d","b","c"],["c","a","b","d"],["d","c","b","c"]],"cbabccz"],"output":false},{"input":[[["c","a","d","a","c","d"],["c","b","b","a","d","a"],["d","a","d","d","b","c"],["d","b","c","a","a","a"],["a","d","d","d","b","a"],["a","a","d","c","d","d"]],"abdadbdc"],"output":true},{"input":[[["c","a","d","a","c","d"],["c","b","b","a","d","a"],["d","a","d","d","b","c"],["d","b","c","a","a","a"],["a","d","d","d","b","a"],["a","a","d","c","d","d"]],"abdadbdcz"],"output":false},{"input":[[["d","a","c","d","b","c","d","d"],["b","c","c","d","a","d","c","c"],["d","b","c","b","d","d"