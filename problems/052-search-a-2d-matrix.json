eed":9009},7093],"output":false},{"input":[[[1],[2]],2],"output":true}],"hints":["Read the matrix as one sorted array of length `m * n` and binary search the index."],"complexity":"O(log(m * n)) time, O(1) space","starter":{"python":"def searchMatrix(matrix, target):\n    # TODO: implement\n    pass\n","javascript":"/**\n * @param {*} matrix\n * @param {*} target\n * @return {*}\n */\nvar searchMatrix = function (matrix, target) {\n  // TODO: implement\n};\n"},"editorial":{"explanation":"The rows are sorted and each row starts after the previous one ends, so the matrix is a single\nsorted sequence that happens to be stored in two dimensions.\n\nBinary search indices `0` to `m * n - 1` and map index `k` to `matrix[k // cols][k % cols]`.\n`O(log(m * n))` time, `O(1)` space.\n\nTwo separate searches — first for the row, then inside it — cost the same and are easier to get\nwrong.","code":{"python":"def searchMatrix(matrix, target):\n    rows, cols = len(matrix), len(matrix[0])\n    lo, hi = 0, rows * cols - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        value = matrix[mid // cols][mid % cols]\n        if value == target:\n            return True\n        if value < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return False\n"},"complexity":"O(log(m * n)) time, O(1) space"}}
