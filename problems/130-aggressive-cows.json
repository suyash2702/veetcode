100000,"lo":0,"hi":1000000000,"seed":18507,"unique":true,"step":17},100000],"output":1},{"input":[{"__gen__":"arange","n":100000},50000],"output":2},{"input":[{"__gen__":"arange","n":100000,"start":0,"step":1000},2],"output":99999000}],"hints":["Sort the stalls, then binary search the answer: can the cows be placed at least `d` apart?","Checking a distance is a greedy left-to-right sweep."],"complexity":"O(n log(max)) time, O(1) space","starter":{"python":"def aggressiveCows(stalls, cows):\n    # TODO: implement\n    pass\n","javascript":"/**\n * @param {*} stalls\n * @param {*} cows\n * @return {*}\n */\nvar aggressiveCows = function (stalls, cows) {\n  // TODO: implement\n};\n"},"editorial":{"explanation":"The same shape as allocating pages: binary search the minimum distance, and check feasibility\ngreedily.\n\nFor a candidate distance, place the first cow in the first stall and then take every stall at least\nthat far from the last placement. If all cows fit, the distance can grow.\n\nSorting the stalls first is what makes the greedy check valid. `O(n log(max position))`.","code":{"python":"def aggressiveCows(stalls, cows):\n    positions = sorted(stalls)\n\n    def fits(distance):\n        placed, last = 1, positions[0]\n        for position in positions[1:]:\n            if position - last >= distance:\n                placed += 1\n                last = position\n                if placed >= cows:\n                    return True\n        return placed >= cows\n\n    lo, hi = 0, positions[-1] - positions[0]\n    best = 0\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if fits(mid):\n            best = mid\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return best\n"},"complexity":"O(n log(max)) time, O(1) space"}}
