{"id":130,"slug":"aggressive-cows","title":"Aggressive Cows","difficulty":"Hard","tags":["Array","Binary Search","Greedy"],"description":"`stalls` holds the positions of stalls along a line. Place `cows` cows in distinct stalls so that the smallest distance between any two of them is as large as possible, and return that distance.\n\n**Constraints**\n\n- `2 <= stalls.length <= 10^5`\n- `2 <= cows <= stalls.length`\n- `0 <= position <= 10^9`","functionName":"aggressiveCows","params":["stalls","cows"],"tests":[{"input":[[1,2,4,8,9],3],"output":3,"sample":true},{"input":[[10,1,2,7,5],3],"output":4,"sample":true},{"input":[[1,2],2],"output":1},{"input":[[0,3,4,7,10,9],4],"output":3},{"input":[{"__gen__":"sorted","n":2,"lo":0,"hi":1000000000,"seed":18500,"unique":true,"step":17},1],"output":25433275},{"input":[{"__gen__":"sorted","n":2,"lo":0,"hi":1000000000,"seed":18500,"unique":true,"step":17},2],"output":25433275},{"input":[{"__gen__":"sorted","n":3,"lo":0,"hi":1000000000,"seed":18501,"unique":true,"step":17},1],"output":672662629},{"input":[{"__gen__":"sorted","n":3,"lo":0,"hi":1000000000,"seed":18501,"unique":true,"step":17},2],"output":672662629},{"input":[{"__gen__":"sorted","n":3,"lo":0,"hi":1000000000,"seed":18501,"unique":true,"step":17},3],"output":107431857},{"input":[{"__gen__":"sorted","n":5,"lo":0,"hi":1000000000,"seed":18502,"unique":true,"step":17},2],"output":915689458},{"input":[{"__gen__":"sorted","n":5,"lo":0,"hi":1000000000,"seed":18502,"unique":true,"step":17},3],"output":370025267},{"input":[{"__gen__":"sorted","n":5,"lo":0,"hi":1000000000,"seed":18502,"unique":true,"step":17},5],"output":3072348},{"input":[{"__gen__":"sorted","n":20,"lo":0,"hi":1000000000,"seed":18503,"unique":true,"step":17},10],"output":58104556},{"input":[{"__gen__":"sorted","n":20,"lo":0,"hi":1000000000,"seed":18503,"unique":true,"step":17},2],"output":988496031},{"input":[{"__gen__":"sorted","n":20,"lo":0,"hi":1000000000,"seed":18503,"unique":true,"step":17},3],"output":4841