b","abb","abbac","abbaac","abbc","abbba","abc","abca","abcaaa","abcc","abbcca","ac","acb","acbb","acc","accc","accb","acbc","acca","cbaac","bacab","bbcbba","aca","acac","acacb","acacca","acab","acbab","abbcab","aa","aab","aaba","aabccb","aabcb","aabb","aac","aaccc","aaccba","abcb","abcca","accbc","accbcc","cabcca","caa","caab","caabca","caacca","caaac","baaca","bcaaab","baaa","accac","aaca","aacaaa","aacaac","aacb","aabbca","aaac","aaacc","aaab","aaabc","aaabb","aacba","aacbac","aacbc","aacac","aaaaa","aaaab","aaaaca","ccbcaa","abcbab"]},{"input":[[["a","a","a","a","a","a","a","a","a","a","a","a"],["a","a","a","a","a","a","a","a","a","a","a","a"],["a","a","a","a","a","a","a","a","a","a","a","a"],["a","a","a","a","a","a","a","a","a","a","a","a"],["a","a","a","a","a","a","a","a","a","a","a","a"],["a","a","a","a","a","a","a","a","a","a","a","a"],["a","a","a","a","a","a","a","a","a","a","a","a"],["a","a","a","a","a","a","a","a","a","a","a","a"],["a","a","a","a","a","a","a","a","a","a","a","a"],["a","a","a","a","a","a","a","a","a","a","a","a"],["a","a","a","a","a","a","a","a","a","a","a","a"],["a","a","a","a","a","a","a","a","a","a","a","a"]],["aaaaaaaaaa","aaaaaaaaaab","ab"]],"output":["aaaaaaaaaa"]},{"input":[[["a","b","c","d","e","f","g","h","i","j","k","l"],["a","b","c","d","e","f","g","h","i","j","k","l"],["a","b","c","d","e","f","g","h","i","j","k","l"],["a","b","c","d","e","f","g","h","i","j","k","l"],["a","b","c","d","e","f","g","h","i","j","k","l"],["a","b","c","d","e","f","g","h","i","j","k","l"],["a","b","c","d","e","f","g","h","i","j","k","l"],["a","b","c","d","e","f","g","h","i","j","k","l"],["a","b","c","d","e","f","g","h","i","j","k","l"],["a","b","c","d","e","f","g","h","i","j","k","l"],["a","b","c","d","e","f","g","h","i","j","k","l"],["a","b","c","d","e","f","g","h","i","j","k","l"]],["abcdefghij","lkjihg","aa"]],"output":["aa","abcdefghij","lkjihg"]}],"hints":["Searching each word separately re-walks the board; put the words in a trie and search once.","Prune trie branches once they are exhausted so long searches stop early."],"compare":"unordered","complexity":"O(m * n * 4^L) worst case, O(total word length) space","starter":{"python":"def findWords(board, words):\n    # TODO: implement\n    pass\n","javascript":"/**\n * @param {*} board\n * @param {*} words\n * @return {*}\n */\nvar findWords = function (board, words) {\n  // TODO: implement\n};\n"},"editorial":{"explanation":"Running the single-word search once per word re-walks the board thousands of times. Put the words\ninto a trie and search the board **once**, descending the trie as you move.\n\nA cell that does not match any child prunes the whole branch immediately. Removing a word from the\ntrie once it is found, and pruning empty nodes on the way out, stops the search from re-exploring\ndead ends.\n\nWorst case `O(m * n * 4^L)`; the trie is what makes it fast in practice.","code":{"python":"def findWords(board, words):\n    trie = {}\n    for word in words:\n        node = trie\n        for ch in word:\n            node = node.setdefault(ch, {})\n        node[\"$\"] = word\n\n    rows, cols = len(board), len(board[0])\n    found = []\n\n    def walk(r, c, node):\n        ch = board[r][c]\n        nxt = node.get(ch)\n        if nxt is None:\n            return\n        word = nxt.pop(\"$\", None)\n        if word is not None:\n            found.append(word)\n        board[r][c] = \"#\"\n        for nr, nc in ((r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)):\n            if 0 <= nr < rows and 0 <= nc < cols and board[nr][nc] != \"#\":\n                walk(nr, nc, nxt)\n        board[r][c] = ch\n        if not nxt:\n            node.pop(ch, None)\n\n    for r in range(rows):\n        for c in range(cols):\n            walk(r, c, trie)\n    return found\n"},"complexity":"O(m * n * 4^L) worst case, O(total word length) space"}}
