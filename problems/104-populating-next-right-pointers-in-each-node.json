  while level:\n        node = level\n        nxt = None\n        tail = None\n        while node:\n            for child in (node.left, node.right):\n                if child is None:\n                    continue\n                if nxt is None:\n                    nxt = child\n                if tail is not None:\n                    tail.next = child\n                tail = child\n            node = getattr(node, \"next\", None)\n        if tail is not None:\n            tail.next = None\n        level = nxt\n    return root\n"},"complexity":"O(n) time, O(1) space"}}
