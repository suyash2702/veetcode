__":"sortof","of":{"__gen__":"concat","parts":[{"__gen__":"duplicate","of":{"__gen__":"without","of":{"__gen__":"sorted","n":200,"lo":0,"hi":100000,"seed":18105,"unique":true},"value":50320}},[50320]]}}],"output":50320},{"input":[{"__gen__":"sortof","of":{"__gen__":"concat","parts":[{"__gen__":"duplicate","of":{"__gen__":"without","of":{"__gen__":"sorted","n":2000,"lo":0,"hi":100000,"seed":18106,"unique":true},"value":50776}},[50776]]}}],"output":50776},{"input":[{"__gen__":"sortof","of":{"__gen__":"concat","parts":[{"__gen__":"duplicate","of":{"__gen__":"without","of":{"__gen__":"sorted","n":2000,"lo":0,"hi":100000,"seed":18106,"unique":true},"value":99910}},[99910]]}}],"output":99910},{"input":[{"__gen__":"sortof","of":{"__gen__":"concat","parts":[{"__gen__":"duplicate","of":{"__gen__":"without","of":{"__gen__":"sorted","n":2000,"lo":0,"hi":100000,"seed":18106,"unique":true},"value":95}},[95]]}}],"output":95},{"input":[{"__gen__":"sortof","of":{"__gen__":"concat","parts":[{"__gen__":"duplicate","of":{"__gen__":"without","of":{"__gen__":"sorted","n":20000,"lo":0,"hi":100000,"seed":18107,"unique":true},"value":2}},[2]]}}],"output":2},{"input":[{"__gen__":"sortof","of":{"__gen__":"concat","parts":[{"__gen__":"duplicate","of":{"__gen__":"without","of":{"__gen__":"sorted","n":20000,"lo":0,"hi":100000,"seed":18107,"unique":true},"value":55122}},[55122]]}}],"output":55122},{"input":[{"__gen__":"sortof","of":{"__gen__":"concat","parts":[{"__gen__":"duplicate","of":{"__gen__":"without","of":{"__gen__":"sorted","n":20000,"lo":0,"hi":100000,"seed":18107,"unique":true},"value":101909}},[101909]]}}],"output":101909},{"input":[{"__gen__":"sortof","of":{"__gen__":"concat","parts":[{"__gen__":"duplicate","of":{"__gen__":"without","of":{"__gen__":"sorted","n":49999,"lo":0,"hi":100000,"seed":18108,"unique":true},"value":1}},[1]]}}],"output":1},{"input":[{"__gen__":"sortof","of":{"__gen__":"concat","parts":[{"__gen__":"duplicate","of":{"__gen__":"without","of":{"__gen__":"sorted","n":49999,"lo":0,"hi":100000,"seed":18108,"unique":true},"value":110761}},[110761]]}}],"output":110761},{"input":[{"__gen__":"sortof","of":{"__gen__":"concat","parts":[{"__gen__":"duplicate","of":{"__gen__":"without","of":{"__gen__":"sorted","n":49999,"lo":0,"hi":100000,"seed":18108,"unique":true},"value":63693}},[63693]]}}],"output":63693},{"input":[[1,2,2]],"output":1}],"hints":["Before the single element, pairs start at even indices; after it, they start at odd ones.","Binary search on that parity to find where the pattern breaks."],"complexity":"O(log n) time, O(1) space","starter":{"python":"def singleNonDuplicate(nums):\n    # TODO: implement\n    pass\n","javascript":"/**\n * @param {*} nums\n * @return {*}\n */\nvar singleNonDuplicate = function (nums) {\n  // TODO: implement\n};\n"},"editorial":{"explanation":"XOR-ing everything gives the answer in `O(n)`, but the array is sorted, so `O(log n)` is available.\n\nBefore the single element, every pair starts at an even index; after it, pairs start at odd indices.\nForce the midpoint to an even index and compare it with its neighbour: if they match, the single\nelement is to the right; if not, it is at the midpoint or to the left.\n\n`O(log n)` time, `O(1)` space.","code":{"python":"def singleNonDuplicate(nums):\n    lo, hi = 0, len(nums) - 1\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if mid % 2 == 1:\n            mid -= 1\n        if nums[mid] == nums[mid + 1]:\n            lo = mid + 2\n        else:\n            hi = mid\n    return nums[lo]\n"},"complexity":"O(log n) time, O(1) space"}}
