strrepeat","value":"a","n":40},["a","aa","aaa","aaaa","aaaaa","aaaaaa","aaaaaaa","aaaaaaaa"]],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"strrepeat","value":"a","n":99},"b"]},["a","aa","aaa","aaaa","aaaaa","aaaaaa","aaaaaaa","aaaaaaaa"]],"output":false},{"input":[{"__gen__":"strrepeat","value":"a","n":100},["a","aa","aaa","aaaa","aaaaa","aaaaaa","aaaaaaa","aaaaaaaa"]],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"strrepeat","value":"a","n":199},"b"]},["a","aa","aaa","aaaa","aaaaa","aaaaaa","aaaaaaa","aaaaaaaa"]],"output":false},{"input":[{"__gen__":"strrepeat","value":"a","n":200},["a","aa","aaa","aaaa","aaaaa","aaaaaa","aaaaaaa","aaaaaaaa"]],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"strrepeat","value":"a","n":299},"b"]},["a","aa","aaa","aaaa","aaaaa","aaaaaa","aaaaaaa","aaaaaaaa"]],"output":false},{"input":[{"__gen__":"strrepeat","value":"a","n":300},["a","aa","aaa","aaaa","aaaaa","aaaaaa","aaaaaaa","aaaaaaaa"]],"output":true},{"input":[{"__gen__":"strrepeat","value":"leetcode","n":37},["leet","code"]],"output":true},{"input":[{"__gen__":"concat","parts":[{"__gen__":"strrepeat","value":"leetcode","n":37},"x"]},["leet","code"]],"output":false},{"input":["a",["a"]],"output":true},{"input":["ab",["a","b"]],"output":true},{"input":["aaaaaaa",["aaaa","aaa"]],"output":true},{"input":["bb",["a","b","bbb","bbbb"]],"output":true},{"input":[{"__gen__":"string","n":8,"alphabet":"ab","seed":5330},["a","aa","ab","b","bb","aab","bba"]],"output":true},{"input":[{"__gen__":"string","n":60,"alphabet":"ab","seed":5332},["a","aa","ab","b","bb","aab","bba"]],"output":true},{"input":[{"__gen__":"string","n":140,"alphabet":"ab","seed":5333},["a","aa","ab","b","bb","aab","bba"]],"output":true},{"input":[{"__gen__":"string","n":220,"alphabet":"ab","seed":5334},["a","aa","ab","b","bb","aab","bba"]],"output":true},{"input":[{"__gen__":"string","n":300,"alphabet":"ab","seed":5335},["a","aa","ab","b","bb","aab","bba"]],"output":true}],"hints":["dp[i] = true when some word ends at position i and dp[start of that word] is also true.","Plain recursion without memoisation blows up on inputs like \"aaaaaaa...b\"."],"complexity":"O(n^2 * k) time","starter":{"python":"def wordBreak(s, wordDict):\n    # TODO: implement\n    pass\n","javascript":"/**\n * @param {*} s\n * @param {*} wordDict\n * @return {*}\n */\nvar wordBreak = function (s, wordDict) {\n  // TODO: implement\n};\n"},"editorial":{"explanation":"Let `ok[i]` mean \"the first `i` characters can be segmented\". It is true when some `j < i` has\n`ok[j]` true and `s[j:i]` in the dictionary.\n\nFill the table left to right; the answer is `ok[n]`. With the dictionary in a hash set, this is\n`O(n^2)` substring checks, or `O(n * maxWordLength)` if you only try lengths that exist.\n\nPlain recursion without memoisation blows up exponentially on inputs like `\"aaaa...b\"`, which is\nexactly what the stress cases here look like.","code":{"python":"def wordBreak(s, wordDict):\n    words = set(wordDict)\n    n = len(s)\n    dp = [False] * (n + 1)\n    dp[0] = True\n    for i in range(1, n + 1):\n        for j in range(i):\n            if dp[j] and s[j:i] in words:\n                dp[i] = True\n                break\n    return dp[n]\n"},"complexity":"O(n^2 * k) time"}}
